# Copy to .env and fill in. Never commit .env.

# --- engawa -----------------------------------------------------------------
# Where your engawa runs, and its ACCESS_PASSWORD if it has one.
ENGAWA_URL=https://engawa.example.com/
ENGAWA_PASSWORD=
# The bot's name on the map.
BOT_NAME=engawa-bot

# --- Groq (transcription + summary) -----------------------------------------
GROQ_API_KEY=
# Chat model used for the summary.
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Language of the summary and of the file names: ja | en
SUMMARY_LANG=ja
# Time zone for folder names and transcript timestamps.
TIMEZONE=Asia/Tokyo

# --- Where the bot hangs out ------------------------------------------------
# Tile coordinates "c,r;c,r" the bot strolls between while idle, away from the
# busy floor. Leave empty to stay put. HOME_POINT (default: the first stroll
# point) is where it returns after a meeting.
STROLL_POINTS=
# HOME_POINT=
# STROLL_MIN_MINUTES=5
# STROLL_MAX_MINUTES=10
# MAX_MEETING_MINUTES=180

# --- Delivery ---------------------------------------------------------------
# local: write each meeting to ./data/meetings/
# drive: upload to a Google shared drive and share it with the caller
DELIVERY=local
# The shared drive (or a folder in it) that meetings go into.
DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
# RECIPIENTS_FILE=./config/recipients.json
# Only addresses on these domains ever get a meeting shared (comma-separated).
ALLOWED_EMAIL_DOMAINS=example.com

# LOG_LEVEL=debug
